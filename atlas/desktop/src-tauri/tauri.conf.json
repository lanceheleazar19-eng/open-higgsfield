{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VISTAN",
  "version": "1.0.0",
  "identifier": "com.vistan.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "VISTAN",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#080808",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 22, "y": 36 },
        "dragDropEnabled": false,
        "tabbingIdentifier": "vistan"
      }
    ],
    "security": {
      "csp": null,
      "freezePrototype": false,
      "capabilities": ["splash"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "copyright": "VISTAN · uso personal",
    "shortDescription": "VISTAN · Personal Intelligence System",
    "longDescription": "Aplicación de escritorio de VISTAN: usa el mismo backend, la misma interfaz y los mismos datos que VISTAN Web.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist",
      "hardenedRuntime": true,
      "signingIdentity": null,
      "dmg": {
        "background": "../assets/dmg-background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 200 },
        "applicationFolderPosition": { "x": 480, "y": 200 }
      }
    }
  }
}

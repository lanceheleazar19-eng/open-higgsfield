# Copia este archivo a backend/.env y ajusta valores. NUNCA subas .env a git.
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8000
# Carpeta de datos (base de datos, copias de seguridad). Relativa a atlas/.
ATLAS_DATA_DIR=../data
ATLAS_TIMEZONE=Europe/Madrid

# --- Cerebro IA ---
# Dirección de Ollama (por defecto la local). El modelo se elige en Configuración.
ATLAS_OLLAMA_URL=http://127.0.0.1:11434
# Futuros proveedores externos (aún no implementados):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

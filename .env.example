# Studio at /
HF_API_BASE_URL=                      # generation API origin, server only
OPEN_HIGGSFIELD_READ_WRITE_TOKEN=     # Vercel Blob read-write token (uploads)

# Escaparate at /escaparate
DATABASE_URL=                         # Postgres (Neon / Supabase / Vercel Postgres)
ESCAPARATE_PLATFORM_KEY=              # generation platform key (id:secret) the business pays with
RESEND_API_KEY=                       # sends the sign-in codes
ANTHROPIC_API_KEY=                    # optional: AI-written sales copy (templates are used without it)
ESCAPARATE_EMAIL_FROM=                # e.g. "Escaparate <hola@tudominio.es>" (verified in Resend)
STRIPE_SECRET_KEY=                    # sk_test_... / sk_live_...
STRIPE_WEBHOOK_SECRET=                # whsec_... for /api/escaparate/stripe
ESCAPARATE_WAITLIST_TOKEN=            # optional: private Vercel Blob store token for the waitlist
NEXT_PUBLIC_SITE_URL=                 # e.g. https://escaparate.es
